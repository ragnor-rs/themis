# Copy to .env and fill in. Never commit the filled-in file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (read by the OpenAI SDK via fromEnv)
OPENAI_API_KEY=

# Pinecone API key
PINECONE_API_KEY=

# Names of the two Pinecone indexes holding the regulation clauses.
# They do not need to exist yet: ./gradlew ingest creates them and fills them.
PINECONE_INDEX_DSA_NAME=themis-dsa
PINECONE_INDEX_GDPR_NAME=themis-gdpr

# Optional. Where a newly created serverless index is placed.
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
