# Copy to .env and fill in. Never commit the filled-in file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (read by the OpenAI SDK via fromEnv)
OPENAI_API_KEY=

# Pinecone API key
PINECONE_API_KEY=

# Names of the two Pinecone indexes holding the regulation clauses.
# See "Pinecone index contract" in README.md for the required schema.
PINECONE_INDEX_DSA_NAME=
PINECONE_INDEX_GDPR_NAME=
